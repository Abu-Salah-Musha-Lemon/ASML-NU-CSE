---
interface Props {
  subjectName: string;
  chapterQB?: string | null;
  previousQB?: string | null;
  notes?: string | null;
}

const { subjectName, chapterQB, previousQB, notes } = Astro.props;

const resources = [
  chapterQB && { label: 'Chapter QB', href: chapterQB },
  previousQB && { label: 'Previous QB', href: previousQB },
  notes && { label: 'Notes', href: notes },
].filter(Boolean) as { label: string; href: string }[];
---

<div class="ticket-edge bg-card border border-line rounded-lg overflow-hidden shadow-sm">
  <div class="border-b border-dashed border-line px-4 py-3 flex items-start justify-between gap-2">
    <h4 class="font-display font-medium text-[15px] text-green-950 leading-snug">
      {subjectName}
    </h4>
  </div>
  <div class="px-4 py-3 flex flex-wrap gap-2">
    {resources.length === 0 && (
      <p class="text-xs text-muted font-tag">Resources not added yet</p>
    )}
    {resources.map((r) => (
      <a
        href={r.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-xs font-tag font-medium px-2.5 py-1.5 rounded border border-green-800/30 text-green-900 bg-green-900/5 hover:bg-green-900 hover:text-white transition-colors"
      >
        {r.label}
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    ))}
  </div>
</div>
