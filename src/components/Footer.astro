---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="bg-green-950 text-paper/90 mt-16">
  <div class="mx-auto max-w-5xl px-4 py-10 grid gap-8 sm:grid-cols-3">
    <div>
      <p class="font-display text-lg text-white mb-2">NU CSE Hon's</p>
      <p class="text-sm text-paper/70 leading-relaxed">
        Question banks, notes, and college info for National University B.Sc. (Hon's) in Computer
        Science &amp; Engineering, Bangladesh.
      </p>
    </div>
    <nav aria-label="Footer">
      <p class="font-tag text-xs uppercase tracking-widest text-gold-300 mb-3">Browse</p>
      <ul class="space-y-2 text-sm text-paper/80">
        <li><a class="hover:text-gold-300" href={`${base}years/`}>Subjects by semester</a></li>
        <li><a class="hover:text-gold-300" href={`${base}colleges/`}>College list</a></li>
        <li><a class="hover:text-gold-300" href={`${base}books/`}>Books &amp; research papers</a></li>
        <li><a class="hover:text-gold-300" href={`${base}links/`}>NU important links</a></li>
      </ul>
    </nav>
    <div>
      <p class="font-tag text-xs uppercase tracking-widest text-gold-300 mb-3">Copyright &amp; disclaimer</p>
      <p class="text-sm text-paper/70 leading-relaxed">
        © {year} NU-CSE. Materials are shared for personal study use. Linked PDFs and Drive folders are
        sourced from various contributors; NU-CSE does not host, verify, or endorse third-party content
        and directs any content complaints to the original source.
      </p>
    </div>
  </div>
  <div class="border-t border-white/10 py-4 text-center text-xs text-paper/50">
    Built by Abu Salah Musha Lemon (AbuSalahMushaLemon)
  </div>
</footer>
