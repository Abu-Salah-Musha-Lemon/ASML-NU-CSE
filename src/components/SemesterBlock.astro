---
import SubjectCard from './SubjectCard.astro';

interface Subject {
  subjectName: string;
  chapterQB?: string | null;
  previousQB?: string | null;
  notes?: string | null;
}

interface Props {
  label: string;
  theory: Subject[];
  lab: Subject[];
  open?: boolean;
}

const { label, theory, lab, open = false } = Astro.props;
const total = theory.length + lab.length;
---

<details class="disclosure group bg-card border border-line rounded-xl overflow-hidden" open={open}>
  <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none hover:bg-paper transition-colors">
    <span class="flex items-center gap-3">
      <span class="font-tag text-xs font-semibold px-2 py-1 rounded bg-green-950 text-gold-300 tracking-wider">
        {label.replace(' Semester', '').toUpperCase()}
      </span>
      <span class="font-display font-semibold text-green-950">{label}</span>
    </span>
    <span class="flex items-center gap-3">
      <span class="text-xs font-tag text-muted">{total} subjects</span>
      <svg class="chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </summary>

  <div class="px-5 pb-5 pt-1 border-t border-line">
    {theory.length > 0 && (
      <div class="mb-5">
        <p class="font-tag text-xs uppercase tracking-widest text-muted mb-2">Theory</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {theory.map((s) => <SubjectCard {...s} />)}
        </div>
      </div>
    )}
    {lab.length > 0 && (
      <div>
        <p class="font-tag text-xs uppercase tracking-widest text-muted mb-2">Lab</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {lab.map((s) => <SubjectCard {...s} />)}
        </div>
      </div>
    )}
    {total === 0 && <p class="text-sm text-muted">No subjects listed for this semester yet.</p>}
  </div>
</details>
