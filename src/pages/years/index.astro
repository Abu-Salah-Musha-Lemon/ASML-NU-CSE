---
import Layout from '../../layouts/Layout.astro';
import SemesterBlock from '../../components/SemesterBlock.astro';
import subjects from '../../data/subjects.json';
import syllabus from '../../data/syllabus.json';

const years = [1, 2, 3, 4].map((year) => ({
  year,
  semesters: subjects.filter((s) => s.year === year),
}));
---

<Layout title="Subjects by Semester">
  <section class="bg-green-950 text-paper">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <p class="font-tag text-xs uppercase tracking-[0.2em] text-gold-300 mb-3">Full syllabus</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-white">Subjects by semester</h1>
      <p class="mt-3 max-w-xl text-paper/70 text-sm leading-relaxed">
        Open a semester to see its theory and lab subjects. Each subject links to its chapter-wise
        question bank, previous year papers, and class notes.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-6">
    <details class="disclosure bg-card border border-line rounded-xl overflow-hidden">
      <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none hover:bg-paper transition-colors">
        <span class="font-display font-semibold text-green-950 text-sm">{syllabus.title}</span>
        <svg class="chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="px-5 pb-5 pt-1 border-t border-line flex flex-wrap gap-2">
        {syllabus.links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-tag font-medium px-3 py-2 rounded border border-green-800/30 text-green-900 bg-green-900/5 hover:bg-green-900 hover:text-white transition-colors"
          >
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 space-y-10">
    {years.map(({ year, semesters }) => (
      <div>
        <h2 class="font-tag text-xs uppercase tracking-widest text-gold-600 mb-3">
          Year {year}
        </h2>
        <div class="space-y-3">
          {semesters.map((s, i) => (
            <SemesterBlock label={s.label} theory={s.theory} lab={s.lab} open={year === 1 && i === 0} />
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
