---
import Layout from '../../layouts/Layout.astro';
import links from '../../data/links.json';
---

<Layout title="NU Important Links">
  <section class="bg-green-950 text-paper">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <p class="font-tag text-xs uppercase tracking-[0.2em] text-gold-300 mb-3">Quick access</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-white">
        National University important links
      </h1>
      <p class="mt-3 max-w-xl text-paper/70 text-sm leading-relaxed">
        Direct links to the National University portals students need most often.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-3 sm:grid-cols-2">
      {links.map((l) => (
        <a
          href={l.url}
          target="_blank"
          rel="noopener noreferrer"
          class="ticket-edge flex items-center justify-between gap-3 bg-card border border-line rounded-lg px-5 py-4 hover:border-gold-600 transition-colors"
        >
          <span class="font-display font-medium text-green-950">{l.label}</span>
          <span class="font-tag text-xs text-gold-600 flex items-center gap-1">
            Open
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 8L8 2M8 2H3M8 2V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
