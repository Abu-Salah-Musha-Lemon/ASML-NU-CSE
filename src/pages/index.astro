---
import Layout from '../layouts/Layout.astro';
import subjects from '../data/subjects.json';
import colleges from '../data/colleges.json';
import books from '../data/books.json';

const base = import.meta.env.BASE_URL;
const subjectCount = subjects.reduce((n, s) => n + s.theory.length + s.lab.length, 0);

const stats = [
  { value: '8', label: 'Semesters mapped' },
  { value: String(subjectCount), label: 'Subjects with QB & notes' },
  { value: String(colleges.length), label: 'Affiliated colleges listed' },
  { value: String(books.length), label: 'Books & project papers' },
];
---

<Layout title="Home">
  <section class="bg-green-950 text-paper">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
      <p class="font-tag text-xs uppercase tracking-[0.2em] text-gold-300 mb-4">
        National University, Bangladesh · B.Sc. Hon's
      </p>
      <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight max-w-2xl text-white">
        Every CSE subject's question bank, in one place.
      </h1>
      <p class="mt-5 max-w-xl text-paper/75 text-base leading-relaxed">
        Structured Programming to your final year project — chapter-wise question banks, previous
        year papers, and class notes for all 8 semesters of the NU CSE Hon's syllabus, plus a list
        of affiliated colleges and useful university links.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`${base}years/`}
          class="inline-flex items-center gap-2 bg-gold-500 text-green-950 font-medium px-5 py-3 rounded-lg hover:bg-gold-300 transition-colors"
        >
          Browse subjects by semester
        </a>
        <a
          href={`${base}colleges/`}
          class="inline-flex items-center gap-2 border border-white/25 text-white font-medium px-5 py-3 rounded-lg hover:bg-white/10 transition-colors"
        >
          See college list
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 -mt-8 relative z-10">
    <div class="bg-card border border-line rounded-xl shadow-sm grid grid-cols-2 sm:grid-cols-4 divide-x divide-line">
      {stats.map((s) => (
        <div class="px-4 py-5 text-center">
          <p class="font-display text-2xl font-semibold text-green-950">{s.value}</p>
          <p class="text-xs text-muted mt-1">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="max-w-2xl">
      <p class="font-tag text-xs uppercase tracking-widest text-gold-600 mb-3">About the department</p>
      <h2 class="font-display text-2xl font-semibold text-green-950 mb-4">
        The first CSE department under National University
      </h2>
      <p class="text-ink/80 leading-relaxed">
        In 1990, National University established the first-ever B.Sc. Honors program in Computer
        Science in Bangladesh — the inaugural department within the university. It was later renamed
        B.Sc. in Computer Science and Engineering (CSE). This site collects the study resources
        students actually need each semester: question banks, notes, and past papers, organised the
        way the syllabus is actually taught.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 grid gap-4 sm:grid-cols-3">
    <a href={`${base}years/`} class="group bg-card border border-line rounded-xl p-5 hover:border-gold-600 transition-colors">
      <p class="font-tag text-xs text-gold-600 mb-1">01</p>
      <h3 class="font-display font-semibold text-green-950 mb-1">Subjects by semester</h3>
      <p class="text-sm text-muted">Chapter QB, previous QB, and notes for every theory and lab course.</p>
    </a>
    <a href={`${base}books/`} class="group bg-card border border-line rounded-xl p-5 hover:border-gold-600 transition-colors">
      <p class="font-tag text-xs text-gold-600 mb-1">02</p>
      <h3 class="font-display font-semibold text-green-950 mb-1">Books &amp; research papers</h3>
      <p class="text-sm text-muted">Project paper formats and reference material for your thesis work.</p>
    </a>
    <a href={`${base}links/`} class="group bg-card border border-line rounded-xl p-5 hover:border-gold-600 transition-colors">
      <p class="font-tag text-xs text-gold-600 mb-1">03</p>
      <h3 class="font-display font-semibold text-green-950 mb-1">NU important links</h3>
      <p class="text-sm text-muted">Result, admission, form fill-up, and student login — one page.</p>
    </a>
  </section>
</Layout>
