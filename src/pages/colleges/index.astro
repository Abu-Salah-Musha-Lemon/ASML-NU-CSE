---
import Layout from '../../layouts/Layout.astro';
import colleges from '../../data/colleges.json';
---

<Layout title="College List">
  <section class="bg-green-950 text-paper">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <p class="font-tag text-xs uppercase tracking-[0.2em] text-gold-300 mb-3">
        {colleges.length} colleges
      </p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-white">
        Affiliated college list
      </h1>
      <p class="mt-3 max-w-xl text-paper/70 text-sm leading-relaxed">
        Colleges under National University offering the CSE Hon's program, with seat count and
        contact details.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="overflow-x-auto bg-card border border-line rounded-xl">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b border-line bg-paper">
            <th class="px-4 py-3 font-tag text-xs uppercase tracking-widest text-muted w-12">#</th>
            <th class="px-4 py-3 font-tag text-xs uppercase tracking-widest text-muted">College</th>
            <th class="px-4 py-3 font-tag text-xs uppercase tracking-widest text-muted">Seats</th>
            <th class="px-4 py-3 font-tag text-xs uppercase tracking-widest text-muted">Address</th>
            <th class="px-4 py-3 font-tag text-xs uppercase tracking-widest text-muted">Website</th>
          </tr>
        </thead>
        <tbody>
          {colleges.map((c) => (
            <tr class="border-b border-line last:border-0 hover:bg-paper/60">
              <td class="px-4 py-3 font-tag text-muted">{c.id}</td>
              <td class="px-4 py-3 font-medium text-green-950">{c.name}</td>
              <td class="px-4 py-3 font-tag">{c.seats}</td>
              <td class="px-4 py-3 text-ink/70">{c.address}</td>
              <td class="px-4 py-3">
                {c.website ? (
                  <a
                    href={c.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-green-800 font-medium hover:text-gold-600 underline underline-offset-2"
                  >
                    Visit
                  </a>
                ) : (
                  <span class="text-muted">—</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
