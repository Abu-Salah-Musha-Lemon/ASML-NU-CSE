---
import Layout from '../../layouts/Layout.astro';
import books from '../../data/books.json';
---

<Layout title="Books & Research Papers">
  <section class="bg-green-950 text-paper">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <p class="font-tag text-xs uppercase tracking-[0.2em] text-gold-300 mb-3">
        {books.length} documents
      </p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-white">
        Books &amp; research papers
      </h1>
      <p class="mt-3 max-w-xl text-paper/70 text-sm leading-relaxed">
        Project paper formats, guidelines, and reference material. Open a title to preview it inline.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 space-y-3">
    {books.map((b, i) => (
      <details class="disclosure bg-card border border-line rounded-xl overflow-hidden">
        <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer select-none hover:bg-paper transition-colors">
          <span class="flex items-center gap-3">
            <span class="font-tag text-xs text-muted w-6">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display font-medium text-green-950">{b.name}</span>
          </span>
          <svg class="chevron shrink-0" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="border-t border-line">
          <iframe
            data-src={b.link}
            title={b.name}
            loading="lazy"
            class="lazy-book-frame w-full h-[500px] block"
          >
          </iframe>
        </div>
      </details>
    ))}
  </section>

  <script>
    // Only fetch a book preview once its <details> is actually opened,
    // instead of loading 20+ iframes on page load.
    document.querySelectorAll('details').forEach((el) => {
      el.addEventListener(
        'toggle',
        () => {
          if (!el.open) return;
          const frame = el.querySelector<HTMLIFrameElement>('.lazy-book-frame');
          if (frame && !frame.src && frame.dataset.src) {
            frame.src = frame.dataset.src;
          }
        },
        { once: false }
      );
    });
  </script>
</Layout>
